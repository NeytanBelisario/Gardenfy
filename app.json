{
  "expo": {
    "name": "Gardenfy",
    "slug": "Gardenfy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gardenfy",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "O Gardenfy usa a câmera para identificar suas plantas por foto.",
        "NSPhotoLibraryUsageDescription": "O Gardenfy acessa a foto escolhida para identificar sua planta."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Gardenfy"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Gardenfy acessa a foto escolhida para identificar sua planta.",
          "cameraPermission": "O Gardenfy usa a câmera para identificar suas plantas por foto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17361d",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
